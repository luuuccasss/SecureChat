# SecureChat Server Configuration
# Copy this file to .env and fill in your actual values

# JWT Authentication
# Random secret of at least 32 characters, the server refuses to start otherwise:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRES_IN=12h

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=securechat
DB_USER=securechat
DB_PASSWORD=your-database-password

# Server Configuration
PORT=3001
NODE_ENV=production
SYNC_DB=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/*,application/pdf,text/plain
UPLOAD_DIR=uploads
FILE_EXPIRATION_DAYS=30

# Security
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
# Number of reverse proxies in front of the server (1 behind nginx), leave empty if none
TRUST_PROXY=

# Socket.IO
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000
